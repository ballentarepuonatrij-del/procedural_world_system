execute_process(COMMAND "${CLI}" --seed 42 --sample 45 30
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI returned ${result}: ${error}")
endif()
execute_process(COMMAND "${CLI}" --seed 42 --sample 14 -15.6 --weather 20
    RESULT_VARIABLE weather_result OUTPUT_VARIABLE weather_output ERROR_VARIABLE weather_error)
if(NOT weather_result EQUAL 0)
    message(FATAL_ERROR "Weather CLI failed: ${weather_error}")
endif()
string(JSON duration GET "${weather_output}" weather elapsed_s)
string(JSON stored GET "${weather_output}" weather stored_water_kg)
string(JSON residual GET "${weather_output}" weather budget_error_kg)
if(NOT duration EQUAL 20 OR stored LESS_EQUAL 0 OR residual LESS -0.01 OR residual GREATER 0.01)
    message(FATAL_ERROR "Invalid weather budget: ${weather_output}")
endif()
execute_process(COMMAND "${CLI}" --weather -1 RESULT_VARIABLE bad_weather OUTPUT_QUIET ERROR_QUIET)
if(NOT bad_weather EQUAL 1)
    message(FATAL_ERROR "Negative weather duration was accepted")
endif()
execute_process(COMMAND "${CLI}" --sample 14.0046 -15.59 --water 60 --rain-mm-h 80
    RESULT_VARIABLE water_result OUTPUT_VARIABLE water_output ERROR_VARIABLE water_error)
if(NOT water_result EQUAL 0)
    message(FATAL_ERROR "Runoff CLI failed: ${water_error}")
endif()
string(JSON rain GET "${water_output}" surface_water rain_m3)
string(JSON water_residual GET "${water_output}" surface_water water_error_m3)
string(JSON solid_residual GET "${water_output}" surface_water solid_error_kg)
string(JSON depth GET "${water_output}" surface_water maximum_depth_m)
if(rain LESS_EQUAL 0 OR depth LESS_EQUAL 0 OR water_residual LESS -0.0001 OR water_residual GREATER 0.0001
   OR solid_residual LESS -0.001 OR solid_residual GREATER 0.001)
    message(FATAL_ERROR "Invalid surface-water ledger: ${water_output}")
endif()
foreach(arguments IN ITEMS "--water;-1" "--water;10;--rain-mm-h;201" "--rain-mm-h;30" "--weather;10;--water;20")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_water OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_water EQUAL 1)
        message(FATAL_ERROR "Invalid water arguments were accepted: ${arguments}")
    endif()
endforeach()

execute_process(COMMAND "${CLI}" --flora --young-flora --grow-days 0 RESULT_VARIABLE young_result OUTPUT_VARIABLE young_output)
execute_process(COMMAND "${CLI}" --flora --young-flora --grow-days 700 RESULT_VARIABLE grown_result OUTPUT_VARIABLE grown_output)
if(NOT young_result EQUAL 0 OR NOT grown_result EQUAL 0)
    message(FATAL_ERROR "Flora CLI failed")
endif()
string(JSON initial_height GET "${young_output}" flora height_sum_m)
string(JSON grown_height GET "${grown_output}" flora height_sum_m)
string(JSON days GET "${grown_output}" flora elapsed_days)
string(JSON species LENGTH "${grown_output}" flora species)
if(NOT days EQUAL 700 OR grown_height LESS_EQUAL initial_height OR species LESS 3)
    message(FATAL_ERROR "Plant growth or diversity absent: ${grown_output}")
endif()
execute_process(COMMAND "${CLI}" --coast --flora RESULT_VARIABLE marine_result OUTPUT_VARIABLE marine_output)
string(JSON marine GET "${marine_output}" flora marine_plants)
if(NOT marine_result EQUAL 0 OR marine LESS 15)
    message(FATAL_ERROR "No coastal underwater plants: ${marine_output}")
endif()
foreach(days IN ITEMS -1 365251 nan)
    execute_process(COMMAND "${CLI}" --grow-days "${days}" RESULT_VARIABLE bad_age OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_age EQUAL 1)
        message(FATAL_ERROR "Invalid growth interval was accepted: ${days}")
    endif()
endforeach()
string(JSON pressure GET "${output}" pressure_Pa)
string(JSON seed GET "${output}" seed)
if(NOT seed EQUAL 42 OR pressure LESS_EQUAL 0 OR pressure GREATER 200000)
    message(FATAL_ERROR "Invalid scientific sample: ${output}")
endif()
execute_process(COMMAND "${CLI}" --sample 91 0
    RESULT_VARIABLE invalid_result OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error)
if(NOT invalid_result EQUAL 1 OR NOT invalid_output STREQUAL "")
    message(FATAL_ERROR "CLI did not reject an invalid latitude")
endif()
foreach(landmark IN ITEMS cave canyon mountains gorge)
    execute_process(COMMAND "${CLI}" --seed 42 --landmark "${landmark}"
        RESULT_VARIABLE landmark_result OUTPUT_VARIABLE landmark_output ERROR_VARIABLE landmark_error)
    if(NOT landmark_result EQUAL 0)
        message(FATAL_ERROR "Landmark CLI failed: ${landmark_error}")
    endif()
    string(JSON elevation GET "${landmark_output}" elevation_m)
    string(JSON landform GET "${landmark_output}" landform)
    if(elevation LESS_EQUAL 0 OR landform STREQUAL "")
        message(FATAL_ERROR "Landmark has no dry viewing point: ${landmark_output}")
    endif()
endforeach()
execute_process(COMMAND "${CLI}" --landmark unknown RESULT_VARIABLE bad_landmark OUTPUT_QUIET ERROR_QUIET)
if(NOT bad_landmark EQUAL 1)
    message(FATAL_ERROR "Unknown landmark was accepted")
endif()
execute_process(COMMAND "${CLI}" --coast --water 120 --wind-m-s 12
    RESULT_VARIABLE sea_result OUTPUT_VARIABLE sea_output ERROR_VARIABLE sea_error)
if(NOT sea_result EQUAL 0)
    message(FATAL_ERROR "Ocean CLI failed: ${sea_error}")
endif()
string(JSON waves GET "${sea_output}" water_motion significant_wave_height_m)
string(JSON current GET "${sea_output}" water_motion current_east_m_s)
string(JSON sea_depth GET "${sea_output}" water_motion water_depth_m)
if(waves LESS_EQUAL 0 OR current LESS_EQUAL 0 OR sea_depth LESS 8)
    message(FATAL_ERROR "Ocean wind forcing is absent: ${sea_output}")
endif()
execute_process(COMMAND "${CLI}" --coast --water 0 --wind-m-s 0
    RESULT_VARIABLE calm_result OUTPUT_VARIABLE calm_output)
string(JSON calm_height GET "${calm_output}" water_motion significant_wave_height_m)
if(NOT calm_result EQUAL 0 OR NOT calm_height EQUAL 0)
    message(FATAL_ERROR "Calm initial sea is not still: ${calm_output}")
endif()
foreach(wind IN ITEMS -1 41 nan)
    execute_process(COMMAND "${CLI}" --wind-m-s "${wind}" RESULT_VARIABLE bad_wind OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_wind EQUAL 1)
        message(FATAL_ERROR "Invalid water wind was accepted: ${wind}")
    endif()
endforeach()
