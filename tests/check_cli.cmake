foreach(kind IN ITEMS jungle temperate taiga mixed)
    execute_process(COMMAND "${CLI}" --forest "${kind}"
        RESULT_VARIABLE forest_result OUTPUT_VARIABLE forest_output ERROR_VARIABLE forest_error)
    if(NOT forest_result EQUAL 0)
        message(FATAL_ERROR "Forest CLI failed: ${forest_error}")
    endif()
    string(JSON trees GET "${forest_output}" flora trees)
    string(JSON height GET "${forest_output}" flora maximum_height_m)
    string(JSON vines GET "${forest_output}" flora liana_hosts)
    if(trees LESS 30 OR height LESS 25)
        message(FATAL_ERROR "Forest has no substantial canopy: ${forest_output}")
    endif()
    if(kind STREQUAL "jungle" AND vines LESS 1)
        message(FATAL_ERROR "Tropical forest lacks lianas")
    endif()
endforeach()
execute_process(COMMAND "${CLI}" --forest invalid RESULT_VARIABLE bad_forest OUTPUT_QUIET ERROR_QUIET)
if(NOT bad_forest EQUAL 1)
    message(FATAL_ERROR "Invalid forest route accepted")
endif()
execute_process(COMMAND "${CLI}" --landmark valley RESULT_VARIABLE valley_result OUTPUT_VARIABLE valley_output)
string(JSON valley_height GET "${valley_output}" elevation_m)
if(NOT valley_result EQUAL 0 OR valley_height LESS 1000)
    message(FATAL_ERROR "Mountain valley route failed: ${valley_output}")
endif()

foreach(kind IN ITEMS natural fine large blizzard drifting thaw)
    execute_process(COMMAND "${CLI}" --snow "${kind}" --snow-seconds 20
        RESULT_VARIABLE snow_result OUTPUT_VARIABLE snow_${kind} ERROR_VARIABLE snow_error)
    if(NOT snow_result EQUAL 0)
        message(FATAL_ERROR "Snow CLI failed: ${snow_error}")
    endif()
    string(JSON elapsed GET "${snow_${kind}}" snow elapsed_s)
    string(JSON depth GET "${snow_${kind}}" snow depth_m)
    string(JSON residual GET "${snow_${kind}}" snow residual_m3)
    if(NOT elapsed EQUAL 20 OR depth LESS_EQUAL 0 OR residual LESS -0.000001 OR residual GREATER 0.000001)
        message(FATAL_ERROR "Invalid snow clock, cover or water-equivalent budget: ${snow_${kind}}")
    endif()
endforeach()
string(JSON fine GET "${snow_fine}" snow large_fraction)
string(JSON large GET "${snow_large}" snow large_fraction)
string(JSON drift_fall GET "${snow_drifting}" snow snowfall_m3)
string(JSON drift_transport GET "${snow_drifting}" snow transported_m3)
string(JSON blizzard_visibility GET "${snow_blizzard}" snow visibility_m)
string(JSON melted GET "${snow_thaw}" snow melt_m3)
if(fine GREATER 0.1 OR large LESS 0.9 OR NOT drift_fall EQUAL 0 OR drift_transport LESS_EQUAL 0 OR blizzard_visibility GREATER 200 OR melted LESS_EQUAL 0)
    message(FATAL_ERROR "Snow experiments did not produce their physical regimes")
endif()
execute_process(COMMAND "${CLI}" --no-snow RESULT_VARIABLE no_snow OUTPUT_VARIABLE disabled_snow)
string(JSON snow_enabled GET "${disabled_snow}" snow enabled)
if(NOT no_snow EQUAL 0 OR snow_enabled)
    message(FATAL_ERROR "Disabled snow is still enabled")
endif()
foreach(arguments IN ITEMS "--snow;unknown" "--snow;fine;--no-snow" "--snow-seconds;1" "--snow;fine;--snow-seconds;-1" "--snow;fine;--snow-seconds;3601" "--snow;fine;--snow-seconds;nan")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_snow OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_snow EQUAL 1)
        message(FATAL_ERROR "Invalid snow arguments accepted: ${arguments}")
    endif()
endforeach()

foreach(seconds IN ITEMS 0 100 160)
    execute_process(COMMAND "${CLI}" --deer --fauna-seconds "${seconds}"
        RESULT_VARIABLE deer_result OUTPUT_VARIABLE deer_${seconds} ERROR_VARIABLE deer_error)
    if(NOT deer_result EQUAL 0)
        message(FATAL_ERROR "Deer CLI failed: ${deer_error}")
    endif()
    string(JSON count LENGTH "${deer_${seconds}}" fauna deer)
    string(JSON elapsed GET "${deer_${seconds}}" fauna elapsed_s)
    if(count LESS 3 OR count GREATER 7 OR NOT elapsed EQUAL seconds)
        message(FATAL_ERROR "Invalid herd size or preview clock: ${deer_${seconds}}")
    endif()
endforeach()
string(JSON rest GET "${deer_100}" fauna deer 0 activity)
string(JSON drink GET "${deer_160}" fauna deer 0 activity)
string(JSON original GET "${deer_0}" fauna deer 0 id)
string(JSON later GET "${deer_160}" fauna deer 0 id)
if(NOT rest STREQUAL "resting" OR NOT drink STREQUAL "drinking" OR NOT original STREQUAL later)
    message(FATAL_ERROR "Expected persistent deer to rest then drink")
endif()
execute_process(COMMAND "${CLI}" --no-fauna RESULT_VARIABLE no_fauna OUTPUT_VARIABLE disabled_fauna)
string(JSON enabled GET "${disabled_fauna}" fauna enabled)
string(JSON count LENGTH "${disabled_fauna}" fauna deer)
if(NOT no_fauna EQUAL 0 OR enabled OR NOT count EQUAL 0)
    message(FATAL_ERROR "Disabled fauna should have no animals")
endif()
foreach(arguments IN ITEMS "--fauna-seconds;1" "--deer;--no-fauna" "--deer;--fauna-seconds;-1" "--deer;--fauna-seconds;3601" "--deer;--fauna-seconds;nan")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_deer OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_deer EQUAL 1)
        message(FATAL_ERROR "Invalid deer arguments accepted: ${arguments}")
    endif()
endforeach()

set(previous_width 0)
foreach(kind IN ITEMS stream river major)
    execute_process(COMMAND "${CLI}" --river "${kind}"
        RESULT_VARIABLE river_result OUTPUT_VARIABLE river_output ERROR_VARIABLE river_error)
    if(NOT river_result EQUAL 0)
        message(FATAL_ERROR "River CLI failed: ${river_error}")
    endif()
    string(JSON width GET "${river_output}" rivers width_m)
    string(JSON depth GET "${river_output}" rivers depth_m)
    string(JSON speed GET "${river_output}" rivers speed_m_s)
    string(JSON wet GET "${river_output}" rivers wet)
    string(JSON runoff GET "${river_output}" rivers runoff_m3_s)
    string(JSON outlet GET "${river_output}" rivers outlet_discharge_m3_s)
    if(NOT wet OR width LESS_EQUAL previous_width OR depth LESS_EQUAL 0 OR speed LESS_EQUAL 0 OR speed GREATER 6.000001 OR NOT runoff STREQUAL outlet)
        message(FATAL_ERROR "Invalid river sample: ${river_output}")
    endif()
    set(previous_width "${width}")
endforeach()
execute_process(COMMAND "${CLI}" --no-rivers RESULT_VARIABLE disabled_rivers OUTPUT_VARIABLE dry_output)
string(JSON river_enabled GET "${dry_output}" rivers enabled)
string(JSON river_wet GET "${dry_output}" rivers wet)
if(NOT disabled_rivers EQUAL 0 OR river_enabled OR river_wet)
    message(FATAL_ERROR "Disabled river module still exposes a channel: ${dry_output}")
endif()
foreach(arguments IN ITEMS "--river;unknown" "--river;major;--no-rivers")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_river OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_river EQUAL 1)
        message(FATAL_ERROR "Invalid river arguments accepted: ${arguments}")
    endif()
endforeach()

execute_process(COMMAND "${CLI}" --seed 42 --sample 45 30
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CLI returned ${result}: ${error}")
endif()
execute_process(COMMAND "${CLI}" --seed 42 --sample 14 -15.6 --weather 20
    RESULT_VARIABLE weather_result OUTPUT_VARIABLE weather_output ERROR_VARIABLE weather_error)
if(NOT weather_result EQUAL 0)
    message(FATAL_ERROR "Weather CLI failed: ${weather_error}")
endif()
string(JSON duration GET "${weather_output}" weather elapsed_s)
string(JSON stored GET "${weather_output}" weather stored_water_kg)
string(JSON residual GET "${weather_output}" weather budget_error_kg)
if(NOT duration EQUAL 20 OR stored LESS_EQUAL 0 OR residual LESS -0.01 OR residual GREATER 0.01)
    message(FATAL_ERROR "Invalid weather budget: ${weather_output}")
endif()
execute_process(COMMAND "${CLI}" --weather -1 RESULT_VARIABLE bad_weather OUTPUT_QUIET ERROR_QUIET)
if(NOT bad_weather EQUAL 1)
    message(FATAL_ERROR "Negative weather duration was accepted")
endif()
execute_process(COMMAND "${CLI}" --sample 14.0046 -15.59 --water 60 --rain-mm-h 80
    RESULT_VARIABLE water_result OUTPUT_VARIABLE water_output ERROR_VARIABLE water_error)
if(NOT water_result EQUAL 0)
    message(FATAL_ERROR "Runoff CLI failed: ${water_error}")
endif()
string(JSON rain GET "${water_output}" surface_water rain_m3)
string(JSON water_residual GET "${water_output}" surface_water water_error_m3)
string(JSON solid_residual GET "${water_output}" surface_water solid_error_kg)
string(JSON depth GET "${water_output}" surface_water maximum_depth_m)
if(rain LESS_EQUAL 0 OR depth LESS_EQUAL 0 OR water_residual LESS -0.0001 OR water_residual GREATER 0.0001
   OR solid_residual LESS -0.001 OR solid_residual GREATER 0.001)
    message(FATAL_ERROR "Invalid surface-water ledger: ${water_output}")
endif()
foreach(arguments IN ITEMS "--water;-1" "--water;10;--rain-mm-h;201" "--rain-mm-h;30" "--weather;10;--water;20")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_water OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_water EQUAL 1)
        message(FATAL_ERROR "Invalid water arguments were accepted: ${arguments}")
    endif()
endforeach()

execute_process(COMMAND "${CLI}" --flora --young-flora --grow-days 0 RESULT_VARIABLE young_result OUTPUT_VARIABLE young_output)
execute_process(COMMAND "${CLI}" --flora --young-flora --grow-days 700 RESULT_VARIABLE grown_result OUTPUT_VARIABLE grown_output)
if(NOT young_result EQUAL 0 OR NOT grown_result EQUAL 0)
    message(FATAL_ERROR "Flora CLI failed")
endif()
string(JSON initial_height GET "${young_output}" flora height_sum_m)
string(JSON grown_height GET "${grown_output}" flora height_sum_m)
string(JSON days GET "${grown_output}" flora elapsed_days)
string(JSON species LENGTH "${grown_output}" flora species)
if(NOT days EQUAL 700 OR grown_height LESS_EQUAL initial_height OR species LESS 3)
    message(FATAL_ERROR "Plant growth or diversity absent: ${grown_output}")
endif()
execute_process(COMMAND "${CLI}" --coast --flora RESULT_VARIABLE marine_result OUTPUT_VARIABLE marine_output)
string(JSON marine GET "${marine_output}" flora marine_plants)
if(NOT marine_result EQUAL 0 OR marine LESS 15)
    message(FATAL_ERROR "No coastal underwater plants: ${marine_output}")
endif()
foreach(days IN ITEMS -1 365251 nan)
    execute_process(COMMAND "${CLI}" --grow-days "${days}" RESULT_VARIABLE bad_age OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_age EQUAL 1)
        message(FATAL_ERROR "Invalid growth interval was accepted: ${days}")
    endif()
endforeach()
foreach(season IN ITEMS 20 150)
    execute_process(COMMAND "${CLI}" --meadow --flora-day "${season}"
        RESULT_VARIABLE meadow_result OUTPUT_VARIABLE meadow_${season} ERROR_VARIABLE meadow_error)
    if(NOT meadow_result EQUAL 0)
        message(FATAL_ERROR "Meadow CLI failed: ${meadow_error}")
    endif()
endforeach()
string(JSON winter_bloom GET "${meadow_20}" flora flowering_plants)
string(JSON summer_bloom GET "${meadow_150}" flora flowering_plants)
string(JSON winter_height GET "${meadow_20}" flora height_sum_m)
string(JSON summer_height GET "${meadow_150}" flora height_sum_m)
if(NOT winter_bloom EQUAL 0 OR summer_bloom LESS 10 OR NOT winter_height STREQUAL summer_height)
    message(FATAL_ERROR "Season preview must change flowering without aging plants")
endif()
foreach(index RANGE 0 7)
    foreach(field IN ITEMS site_id species height_m age_days)
        string(JSON winter_value GET "${meadow_20}" flora nearest ${index} ${field})
        string(JSON summer_value GET "${meadow_150}" flora nearest ${index} ${field})
        if(NOT winter_value STREQUAL summer_value)
            message(FATAL_ERROR "Season preview changed a rooted plant: ${field}")
        endif()
    endforeach()
endforeach()
foreach(age IN ITEMS 0 150)
    execute_process(COMMAND "${CLI}" --meadow --young-flora --flora-day 0 --grow-days "${age}"
        RESULT_VARIABLE flower_growth_result OUTPUT_VARIABLE flower_growth_output)
    if(NOT flower_growth_result EQUAL 0)
        message(FATAL_ERROR "Growing meadow CLI failed")
    endif()
    string(JSON bloom_${age} GET "${flower_growth_output}" flora flowering_plants)
    string(JSON calendar_${age} GET "${flower_growth_output}" flora calendar_day)
endforeach()
if(NOT bloom_0 EQUAL 0 OR bloom_150 LESS 10 OR NOT calendar_150 EQUAL 150)
    message(FATAL_ERROR "Young plants must reach flowering age as the biological season advances")
endif()
foreach(day IN ITEMS nan 10000001 1oops)
    execute_process(COMMAND "${CLI}" --flora-day "${day}" RESULT_VARIABLE bad_season OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_season EQUAL 1)
        message(FATAL_ERROR "Invalid floral calendar accepted: ${day}")
    endif()
endforeach()

string(JSON pressure GET "${output}" pressure_Pa)
string(JSON seed GET "${output}" seed)
if(NOT seed EQUAL 42 OR pressure LESS_EQUAL 0 OR pressure GREATER 200000)
    message(FATAL_ERROR "Invalid scientific sample: ${output}")
endif()
execute_process(COMMAND "${CLI}" --sample 91 0
    RESULT_VARIABLE invalid_result OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error)
if(NOT invalid_result EQUAL 1 OR NOT invalid_output STREQUAL "")
    message(FATAL_ERROR "CLI did not reject an invalid latitude")
endif()
foreach(landmark IN ITEMS cave canyon mountains gorge)
    execute_process(COMMAND "${CLI}" --seed 42 --landmark "${landmark}"
        RESULT_VARIABLE landmark_result OUTPUT_VARIABLE landmark_output ERROR_VARIABLE landmark_error)
    if(NOT landmark_result EQUAL 0)
        message(FATAL_ERROR "Landmark CLI failed: ${landmark_error}")
    endif()
    string(JSON elevation GET "${landmark_output}" elevation_m)
    string(JSON landform GET "${landmark_output}" landform)
    if(elevation LESS_EQUAL 0 OR landform STREQUAL "")
        message(FATAL_ERROR "Landmark has no dry viewing point: ${landmark_output}")
    endif()
endforeach()
execute_process(COMMAND "${CLI}" --landmark unknown RESULT_VARIABLE bad_landmark OUTPUT_QUIET ERROR_QUIET)
if(NOT bad_landmark EQUAL 1)
    message(FATAL_ERROR "Unknown landmark was accepted")
endif()
execute_process(COMMAND "${CLI}" --coast --water 120 --wind-m-s 12
    RESULT_VARIABLE sea_result OUTPUT_VARIABLE sea_output ERROR_VARIABLE sea_error)
if(NOT sea_result EQUAL 0)
    message(FATAL_ERROR "Ocean CLI failed: ${sea_error}")
endif()
string(JSON waves GET "${sea_output}" water_motion significant_wave_height_m)
string(JSON current GET "${sea_output}" water_motion current_east_m_s)
string(JSON sea_depth GET "${sea_output}" water_motion water_depth_m)
if(waves LESS_EQUAL 0 OR current LESS_EQUAL 0 OR sea_depth LESS 8)
    message(FATAL_ERROR "Ocean wind forcing is absent: ${sea_output}")
