execute_process(COMMAND "${CLI}" --seed 42 --ice freeze --ice-hours 72 RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Ice CLI failed: ${error}")
endif()
string(JSON thickness GET "${output}" ice thickness_m)
string(JSON residual GET "${output}" ice residual_m3)
string(JSON supports GET "${output}" ice supports)
if(thickness LESS 0.1 OR NOT supports OR residual LESS -0.00001 OR residual GREATER 0.00001)
    message(FATAL_ERROR "Invalid ice preview or ledger: ${output}")
endif()
foreach(args IN ITEMS "--ice-hours;24" "--ice;unknown" "--ice;freeze;--ice-hours;169" "--ice;freeze;--no-ice")
    execute_process(COMMAND "${CLI}" ${args} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid ice arguments accepted: ${args}")
    endif()
endforeach()
