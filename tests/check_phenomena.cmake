foreach(kind IN ITEMS rainbow halo pillar aurora lightning fog dust)
    execute_process(COMMAND "${CLI}" --phenomenon "${kind}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Phenomenon CLI ${kind}: ${error}")
    endif()
    set(field "${kind}")
    if(kind STREQUAL "lightning")
        set(field distant_lightning)
    endif()
    string(JSON strength GET "${output}" phenomena "${field}")
    string(JSON enabled GET "${output}" phenomena enabled)
    string(JSON experiment GET "${output}" phenomena experiment)
    if(NOT enabled OR NOT experiment STREQUAL kind OR strength LESS 0.1)
        message(FATAL_ERROR "Missing preview conditions: ${output}")
    endif()
    if(kind STREQUAL "fog" OR kind STREQUAL "dust")
        string(JSON visibility GET "${output}" phenomena visibility_m)
        if(visibility GREATER 250)
            message(FATAL_ERROR "No haze extinction: ${output}")
        endif()
    else()
        string(JSON triangles GET "${output}" phenomena optical_triangles)
        if(triangles LESS 1 OR triangles GREATER 6000)
            message(FATAL_ERROR "Invalid optical geometry budget: ${output}")
        endif()
    endif()
endforeach()
execute_process(COMMAND "${CLI}" --phenomenon natural --no-phenomena
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Disabled atmosphere CLI failed: ${error}")
endif()
string(JSON enabled GET "${output}" phenomena enabled)
string(JSON triangles GET "${output}" phenomena optical_triangles)
string(JSON particles GET "${output}" phenomena dust_particles)
if(enabled OR NOT triangles EQUAL 0 OR NOT particles EQUAL 0)
    message(FATAL_ERROR "Disabled module leaves residual geometry: ${output}")
endif()
execute_process(COMMAND "${CLI}" --phenomenon aurora --no-global-weather --weather 1
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Aurora should not depend on Global weather: ${error}")
endif()
string(JSON strength GET "${output}" phenomena aurora)
if(strength LESS 0.1)
    message(FATAL_ERROR "Missing independent aurora")
endif()
foreach(arguments IN ITEMS "--phenomenon;unknown" "--phenomenon;rainbow;--no-phenomena" "--phenomenon;lightning;--no-global-weather")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid preview accepted: ${arguments}")
    endif()
endforeach()
