{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 / Windows x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": { "PLANET_BUILD_DESKTOP": "ON", "BUILD_TESTING": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-core",
      "displayName": "Portable simulation core",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-core",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "PLANET_BUILD_DESKTOP": "OFF", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "linux-core", "configurePreset": "linux-core" }
  ],
  "testPresets": [
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-core", "configurePreset": "linux-core", "output": { "outputOnFailure": true } }
  ]
}
