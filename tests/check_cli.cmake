execute_process(COMMAND "${CLI}" --storm hurricane --water 120
    RESULT_VARIABLE storm_result OUTPUT_VARIABLE storm_output ERROR_VARIABLE storm_error)
if(NOT storm_result EQUAL 0)
    message(FATAL_ERROR "Storm CLI failed: ${storm_error}")
endif()
string(JSON storm_wind GET "${storm_output}" water_motion wind_10m_m_s)
string(JSON storm_waves GET "${storm_output}" water_motion significant_wave_height_m)
string(JSON storm_rain GET "${storm_output}" weather rain_mm_h)
string(JSON storm_residual GET "${storm_output}" weather budget_error_kg)
string(JSON systems LENGTH "${storm_output}" global_weather systems)
if(storm_wind LESS 33 OR storm_waves LESS 0.1 OR storm_rain LESS_EQUAL 0 OR systems LESS 3 OR
   storm_residual LESS -0.001 OR storm_residual GREATER 0.001)
    message(FATAL_ERROR "Global storm is not coupled to local conditions: ${storm_output}")
endif()
execute_process(COMMAND "${CLI}" --storm cyclone --global-hours 6 RESULT_VARIABLE forecast_result OUTPUT_VARIABLE forecast_output)
string(JSON forecast_steps GET "${forecast_output}" global_weather steps)
string(JSON forecast_time GET "${forecast_output}" global_weather elapsed_s)
string(JSON local_time GET "${forecast_output}" weather elapsed_s)
if(NOT forecast_result EQUAL 0 OR NOT forecast_steps EQUAL 72 OR NOT forecast_time EQUAL 21600 OR NOT local_time EQUAL 0)
    message(FATAL_ERROR "Global-only preview has invalid clock semantics: ${forecast_output}")
endif()
execute_process(COMMAND "${CLI}" --no-global-weather --global-hours 2 RESULT_VARIABLE disabled_result OUTPUT_VARIABLE disabled_output)
string(JSON enabled GET "${disabled_output}" global_weather enabled)
string(JSON stopped GET "${disabled_output}" global_weather elapsed_s)
if(NOT disabled_result EQUAL 0 OR enabled OR NOT stopped EQUAL 0)
    message(FATAL_ERROR "Disabled global model advanced")
endif()
foreach(arguments IN ITEMS "--global-hours;-1" "--global-hours;241" "--global-hours;nan" "--storm;unknown")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE invalid_global OUTPUT_QUIET ERROR_QUIET)
    if(NOT invalid_global EQUAL 1)
        message(FATAL_ERROR "Invalid global weather arguments accepted: ${arguments}")
    endif()
endforeach()

set(audio_file "${CMAKE_CURRENT_BINARY_DIR}/sound preview.wav")
execute_process(COMMAND "${CLI}" --storm thunderstorm --audio "${audio_file}" --audio-seconds 4
    RESULT_VARIABLE audio_result OUTPUT_VARIABLE audio_output ERROR_VARIABLE audio_error)
if(NOT audio_result EQUAL 0)
    message(FATAL_ERROR "Audio CLI failed: ${audio_error}")
endif()
string(JSON rate GET "${audio_output}" audio sample_rate_hz)
string(JSON frames GET "${audio_output}" audio frames)
string(JSON peak GET "${audio_output}" audio peak_pcm)
string(JSON thunder GET "${audio_output}" audio thunder_events)
string(JSON elapsed GET "${audio_output}" weather elapsed_s)
file(SIZE "${audio_file}" wave_size)
file(READ "${audio_file}" wave_header LIMIT 44 HEX)
if(NOT rate EQUAL 48000 OR NOT frames EQUAL 192000 OR peak LESS 1000 OR peak GREATER 29490 OR
   thunder LESS 1 OR NOT elapsed EQUAL 4 OR NOT wave_size EQUAL 768044 OR
   NOT wave_header MATCHES "^52494646.*57415645666d7420100000000100020080bb000000ee02000400100064617461")
    message(FATAL_ERROR "Invalid synthesized WAV: ${audio_output}; header=${wave_header}")
endif()
execute_process(COMMAND "${CLI}" --storm thunderstorm --audio "${audio_file}" --audio-seconds 0.5 --no-sound
    RESULT_VARIABLE silent_result OUTPUT_VARIABLE silent_output)
string(JSON silent_peak GET "${silent_output}" audio peak_pcm)
if(NOT silent_result EQUAL 0 OR NOT silent_peak EQUAL 0)
    message(FATAL_ERROR "Sound module did not silence WAV synthesis")
endif()
file(REMOVE "${audio_file}")
foreach(arguments IN ITEMS "--audio-seconds;1" "--audio;${audio_file};--audio-seconds;61" "--volume;-1" "--volume;101" "--volume;nan")
    execute_process(COMMAND "${CLI}" ${arguments} RESULT_VARIABLE bad_audio OUTPUT_QUIET ERROR_QUIET)
    if(NOT bad_audio EQUAL 1)
        message(FATAL_ERROR "Invalid audio arguments accepted: ${arguments}")
    endif()
endforeach()
